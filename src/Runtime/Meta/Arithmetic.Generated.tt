<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ output extension=".cs" #>
<# Type[] typesInteger = new[] {
	typeof(SByte), typeof(Int16), typeof(Int32), typeof(Int64),
	typeof(Byte), typeof(UInt16), typeof(UInt32), typeof(UInt64)
}; #>
<# int[] sizesInteger = new[] {
	1, 2, 4, 8,
	1, 2, 4, 8
}; #>
<# Type[] typesFloat = new[] {
	typeof(Single), typeof(Double), typeof(Decimal)
}; #>
using System;

namespace Chips.Runtime.Meta {
	public static partial class Arithmetic {
<#
for (int i = 0; i < typesInteger.Length; i++) {
	string type = typesInteger[i].Name;
	bool unsigned = type.StartsWith("U"), small = sizesInteger[i] < 8, verysmall = sizesInteger[i] < 4;
	string unit = (unsigned ? "U" : "") + (small ? "Int32" : "Int64");
	string intermediaryUnit = verysmall ? "UInt16" : unit;
	string constantSuffix = (unsigned ? "u" : "") + (small ? "" : "L");
	int size = sizesInteger[i];
#>
		public static void RotateLeft(ref Status ps, <#= type #> value, int bits, ref <#= type #> target) {
			const <#= unit #> ONE = 1<#= constantSuffix #>;
			const int ONE_SMALL = 1;
			bool carry = ps.Carry;

			for (int i = 0; i < bits; i++) {
				<#= unit #> shiftIn = carry ? ONE : 0;
				carry = (value & (ONE << (sizeof(<#= type #>) * 8 - ONE_SMALL))) != 0;
				value = (<#= type #>)((<#= intermediaryUnit #>)((<#= intermediaryUnit #>)value << ONE_SMALL) | shiftIn);
			}

			ps.Update(value);
			ps.Carry = carry;
			target = value;
		}

		public static void RotateLeftNoCarry(<#= type #> value, int bits, ref <#= type #> target) {
			const <#= unit #> ONE = 1<#= constantSuffix #>;
			const int ONE_SMALL = 1;

			for (int i = 0; i < bits; i++) {
				<#= unit #> shiftIn = (value & (ONE << (sizeof(<#= type #>) * 8 - ONE_SMALL))) != 0 ? ONE : 0; 
				value = (<#= type #>)((<#= intermediaryUnit #>)((<#= intermediaryUnit #>)value << ONE_SMALL) | shiftIn);
			}

			target = value;
		}

		public static void RotateRight(ref Status ps, <#= type #> value, int bits, ref <#= type #> target) {
			const <#= unit #> ONE = 1<#= constantSuffix #>;
			const int ONE_SMALL = 1;
			bool carry = ps.Carry;

			for (int i = 0; i < bits; i++) {
				<#= unit #> shiftIn = carry ? (ONE << (sizeof(<#= type #>) * 8 - ONE_SMALL)) : 0;
				carry = (value & ONE) != 0;
				value = (<#= type #>)((<#= intermediaryUnit #>)((<#= intermediaryUnit #>)value >> ONE_SMALL) | shiftIn);
			}

			ps.Update(value);
			ps.Carry = carry;
			target = value;
		}

		public static void RotateRight(<#= type #> value, int bits, ref <#= type #> target) {
			const <#= unit #> ONE = 1<#= constantSuffix #>;
			const int ONE_SMALL = 1;

			for (int i = 0; i < bits; i++) {
				<#= unit #> shiftIn = (value & ONE) != 0 ? (ONE << (sizeof(<#= type #>) * 8 - ONE_SMALL)) : 0;
				value = (<#= type #>)((<#= intermediaryUnit #>)((<#= intermediaryUnit #>)value >> ONE_SMALL) | shiftIn);
			}

			target = value;
		}

<#
}
#>
	}
}