<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ output extension=".cs" #>
<# (string name, byte start, byte count)[] registers = new (string, byte, byte)[] {
    ("PTR", 0x00, 16),
    ("Z",   0x10, 32),
    ("FL",  0x30, 32),
    ("S",   0x50, 16),
    ("OBJ", 0x60, 64),
    ("V",   0xA0, 16),
    ("T",   0xB0, 16),
    ("R",   0xFA, 3),
    ("EX",  0xFD, 1),
    ("PS",  0xFE, 1),
    ("ANS", 0xFF, 1)
}; #>
namespace Chips.Runtime.Meta {
    public enum Register : byte {
<#
foreach (var (name, start, count) in registers) {
    for (int i = start; i < start + count; i++) {
    string hexLocal = count == 1 ? "" : $"_{i - start:X}";
    string hexAbsolute = $"0x{i:X2}";
#>
        <#= name #><#= hexLocal #> = <#= hexAbsolute #>,
<#
    }
}
#>
    }
}