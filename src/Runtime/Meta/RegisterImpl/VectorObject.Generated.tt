<#@ template debug="false" hostspecific="true" language="C#" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ output extension=".cs" #>
<# (string fieldPostfix, string typeName)[] types = new (string, string)[] {
	("2", "Vector2"),
	("3", "Vector3"),
	("4", "Vector4"),
	("Byte", "Vector<byte>"),
	("Double", "Vector<double>"),
	("Int16", "Vector<short>"),
	("Int32", "Vector<int>"),
	("Int64", "Vector<long>"),
	("SByte", "Vector<sbyte>"),
	("Single", "Vector<float>"),
	("UInt16", "Vector<ushort>"),
	("UInt32", "Vector<uint>"),
	("UInt64", "Vector<ulong>")
}; #>
using System.Numerics;
using System.Runtime.CompilerServices;

namespace Chips.Runtime.Meta {
	partial class ObjectOperations {
<#
foreach (var (fieldPostfix, typeName) in types) {
#>
		[MethodImpl(MethodImplOptions.AggressiveInlining)]
		private static _VectorObject Add_Vector<#= fieldPostfix #>(in _VectorObject source, in _VectorObject operand) {
			<#= typeName #> result = source.data.Vector<#= fieldPostfix #> + operand.data.Vector<#= fieldPostfix #>;
			return result.AsVector();
		}

<#
}
#>
	}
}