; This file serves as an example of how Chips code is structured
.import System

.namespace Sample {
	.type class assembly static Program {
		.method public static Main(args: string[]) -> void {
			; Print "Hello world!"
			push "Hello world!"
			call Console::WriteLine(string)

			; Calculate something with ints, then print it
			setans 100
			add $ANS, 15
			div $ANS, 3
			mul $ANS, 4
			tostr
			sprep $ANS, "(100 + 15) / 3 * 4 = "
			push $ANS
			call Console::WriteLine(string)

			; Calculate something with floats, then print it
			setans 45.0f
			sub $ANS, 15.25f
			mul $ANS, 13.5d   ; Multiplying by larger number type (double > float) will upcast to it
			sfmt $ANS, "N3"
			sprep $ANS, "(45.0 - 15.25) * 13.5 = "
			push $ANS
			call Console::WriteLine(string)

			ret
		}
	}
}